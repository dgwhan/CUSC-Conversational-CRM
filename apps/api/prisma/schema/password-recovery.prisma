enum PasswordRecoveryChallengeStatus {
  INELIGIBLE
  PENDING_SEND
  PENDING_VERIFICATION
  VERIFIED
  COMPLETED
  EXPIRED
  LOCKED
  SUPERSEDED
  SEND_FAILED
}

enum PasswordRecoveryDeliveryStatus {
  PENDING
  SENDING
  SENT
  RETRY_WAIT
  FAILED
  SUPERSEDED
}

enum PasswordRecoveryRateLimitScope {
  IP_REQUEST
  EMAIL_REQUEST
  EMAIL_SEND
  IP_VERIFY
  IP_RESET
}

//lưu trạng thái xác minh OTP và khôi phục mật khẩu của một yêu cầu
model PasswordRecoveryChallenge {
  id                   String                          @id @default(uuid()) @db.Uuid
  userId               String?                         @map("user_id") @db.Uuid
  emailKey             String                          @map("email_key") @db.VarChar(64)
  status               PasswordRecoveryChallengeStatus @default(PENDING_SEND)
  otpVerifier          String?                         @map("otp_verifier") @db.VarChar(64)
  expiresAt            DateTime?                       @map("expires_at") @db.Timestamptz(6)
  resetTokenHash       String?                         @map("reset_token_hash") @db.VarChar(64)
  resetTokenExpiresAt  DateTime?                       @map("reset_token_expires_at") @db.Timestamptz(6)
  failedAttempts       Int                             @default(0) @map("failed_attempts") @db.SmallInt
  lastSuccessfulSendAt DateTime?                       @map("last_successful_send_at") @db.Timestamptz(6)
  emailKeyVersion      Int                             @map("email_key_version") @db.SmallInt
  otpKeyVersion        Int?                            @map("otp_key_version") @db.SmallInt
  verifiedAt           DateTime?                       @map("verified_at") @db.Timestamptz(6)
  consumedAt           DateTime?                       @map("consumed_at") @db.Timestamptz(6)
  createdAt            DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  deliveries PasswordRecoveryDelivery[]

  @@index([emailKey])
  @@index([emailKey, status])
  @@index([resetTokenHash])
  @@index([status, expiresAt])
  @@map("password_recovery_challenges")
}

//lưu từng lần gửi email OTP và trạng thái gửi
model PasswordRecoveryDelivery {
  id                    String                         @id @default(uuid()) @db.Uuid
  challengeId           String                         @map("challenge_id") @db.Uuid
  generation            Int
  status                PasswordRecoveryDeliveryStatus @default(PENDING)
  otpVerifier           String                         @map("otp_verifier") @db.VarChar(64)
  otpCiphertext         Bytes?                         @map("otp_ciphertext")
  attemptCount          Int                            @default(0) @map("attempt_count") @db.SmallInt
  nextAttemptAt         DateTime?                      @map("next_attempt_at") @db.Timestamptz(6)
  leaseOwner            String?                        @map("lease_owner") @db.VarChar(128)
  leaseUntil            DateTime?                      @map("lease_until") @db.Timestamptz(6)
  fencingGeneration     BigInt                         @default(0) @map("fencing_generation")
  otpKeyVersion         Int                            @map("otp_key_version") @db.SmallInt
  ciphertextKeyVersion  Int                            @map("ciphertext_key_version") @db.SmallInt
  createdAt             DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  sentAt                DateTime?                      @map("sent_at") @db.Timestamptz(6)

  challenge PasswordRecoveryChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, generation])
  @@index([status, nextAttemptAt])
  @@index([challengeId, status])
  @@map("password_recovery_deliveries")
}

//lưu bộ đếm giới hạn tần suất dùng chung theo phạm vi và khoảng thời gian
model PasswordRecoveryRateLimitBucket {
  id          String                        @id @default(uuid()) @db.Uuid
  scope       PasswordRecoveryRateLimitScope
  keyHash     String                        @map("key_hash") @db.VarChar(64)
  windowStart DateTime                      @map("window_start") @db.Timestamptz(6)
  count       Int                           @default(0)
  expiresAt   DateTime                      @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([scope, keyHash, windowStart])
  @@index([expiresAt])
  @@map("password_recovery_rate_limit_buckets")
}
