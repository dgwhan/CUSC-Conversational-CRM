model Contact {
    id                  String            @id @default(uuid()) @db.Uuid
    displayName         String            @map("display_name") @db.VarChar(255)
    phoneNormalized     String?           @unique @map("phone_normalized") @db.VarChar(50)
    email               String?           @db.VarChar(255)
    notes               String?           @db.Text
    isMerged            Boolean           @default(false) @map("is_merged")
    mergedIntoContactId String?           @map("merged_into_contact_id") @db.Uuid
    createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

    channelIdentities   ChannelIdentity[]
    mergeLogsTarget     ContactMergeLog[] @relation("MergeTargetContact")

    @@index([isMerged])
    @@index([mergedIntoContactId])
    @@map("contacts")
}

model ChannelIdentity {
    id             String    @id @default(uuid()) @db.Uuid
    contactId      String?   @map("contact_id") @db.Uuid
    customerId     String?   @map("customer_id") @db.Uuid
    channel        Channel
    externalUserId String    @map("external_user_id") @db.VarChar(255)
    createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

    contact        Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
    customer       Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

    @@unique([channel, externalUserId])
    @@index([contactId])
    @@index([customerId])
    @@map("channel_identities")
}

model ContactMergeLog {
    id              String    @id @default(uuid()) @db.Uuid
    targetContactId String    @map("target_contact_id") @db.Uuid
    sourceContactId String    @map("source_contact_id") @db.Uuid
    phoneNormalized String    @map("phone_normalized") @db.VarChar(50)
    mergeType       String    @default("AUTO_PHONE_MATCH") @map("merge_type") @db.VarChar(50)
    actorId         String?   @map("actor_id") @db.Uuid
    snapshotData    Json      @map("snapshot_data") @db.JsonB
    isReverted      Boolean   @default(false) @map("is_reverted")
    revertedAt      DateTime? @map("reverted_at") @db.Timestamptz(3)
    revertedBy      String?   @map("reverted_by") @db.Uuid
    createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

    targetContact   Contact   @relation("MergeTargetContact", fields: [targetContactId], references: [id], onDelete: Cascade)

    @@index([targetContactId])
    @@index([sourceContactId])
    @@index([phoneNormalized])
    @@map("contact_merge_logs")
}

model CustomerMergeLog {
    id               String    @id @default(uuid()) @db.Uuid
    targetCustomerId String    @map("target_customer_id") @db.Uuid
    sourceCustomerId String    @map("source_customer_id") @db.Uuid
    phoneNormalized  String    @map("phone_normalized") @db.VarChar(50)
    mergeType        String    @default("AUTO_PHONE_MATCH") @map("merge_type") @db.VarChar(50)
    actorId          String?   @map("actor_id") @db.Uuid
    snapshotData     Json      @map("snapshot_data") @db.JsonB
    isReverted       Boolean   @default(false) @map("is_reverted")
    revertedAt       DateTime? @map("reverted_at") @db.Timestamptz(3)
    revertedBy       String?   @map("reverted_by") @db.Uuid
    createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

    targetCustomer   Customer  @relation("MergeTargetCustomer", fields: [targetCustomerId], references: [id], onDelete: Cascade)

    @@index([targetCustomerId])
    @@index([sourceCustomerId])
    @@index([phoneNormalized])
    @@map("customer_merge_logs")
}
