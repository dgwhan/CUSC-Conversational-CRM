{
  "name": "recruitment-crm",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build:api": "pnpm --filter api build",
    "start:api": "pnpm --filter api start:prod",
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web dev",
    "prisma:generate": "pnpm --filter api prisma generate",
    "prisma:migrate": "pnpm --filter api prisma migrate dev",
    "prisma:push": "pnpm --filter api prisma db push",
    "prisma:seed": "pnpm --filter api prisma:seed",
    "prisma:studio": "pnpm --filter api prisma studio",
    "db:reset": "pnpm --filter api prisma db push --force-reset && pnpm --filter api prisma generate && pnpm --filter api prisma:seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "msgpackr-extract",
      "prisma"
    ]
  }
}
