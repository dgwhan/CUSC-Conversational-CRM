# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ==========================================
# PostgreSQL Database Configuration
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=recruitment_crm
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Database Connection URL
# - Khi chạy trong Docker: dùng host 'postgres'
# - Khi chạy API trên máy host (ngoài Docker): dùng host 'localhost'
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/recruitment_crm?schema=public

# ==========================================
# Authentication & Security Secrets
# ==========================================
# Khóa JWT bí mật (tối thiểu 32 ký tự, bắt buộc đổi trong production)
JWT_ACCESS_SECRET=daylasecretkeysieucapbimat32kytu
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# Khóa mã hóa Token AES-256-GCM (tối thiểu 32 ký tự, dùng mã hóa Page Access Token)
TOKEN_ENCRYPTION_KEY=c0a80101f3e2d1c0b9a80706050403020100ffeeddccbbaa9988776655443322

# ==========================================
# Social Media OAuth Credentials (Meta / Zalo / TikTok)
# ==========================================
# Meta / Facebook for Developers
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=cusc_recruitment_crm_webhook_verify_secret

# Zalo for Developers
ZALO_APP_ID=
ZALO_APP_SECRET=

# TikTok for Business
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
