# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ==========================================
# PostgreSQL Database Configuration
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=recruitment_crm
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Database Connection URL
# - Khi chạy trong Docker: dùng host 'postgres'
# - Khi chạy API trên máy host (ngoài Docker): dùng host 'localhost'
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/recruitment_crm?schema=public

# ==========================================
# Authentication & Security Secrets
# ==========================================
# Khóa JWT bí mật (tối thiểu 32 ký tự, bắt buộc đổi trong production)
JWT_ACCESS_SECRET=daylasecretkeysieucapbimat32kytu
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# Khóa mã hóa Token AES-256-GCM (tối thiểu 32 ký tự, dùng mã hóa Page Access Token)
TOKEN_ENCRYPTION_KEY=c0a80101f3e2d1c0b9a80706050403020100ffeeddccbbaa9988776655443322

# ==========================================
# SMTP Mail Delivery (leave MAIL_HOST blank to disable)
# ==========================================
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# ==========================================
# Password Recovery
# Generate three distinct keys with: openssl rand -base64 32
# ==========================================
PASSWORD_RECOVERY_EMAIL_HMAC_KEY=
PASSWORD_RECOVERY_OTP_HMAC_KEY=
PASSWORD_RECOVERY_OTP_ENCRYPTION_KEY=
PASSWORD_RECOVERY_IP_REQUEST_LIMIT=20
PASSWORD_RECOVERY_EMAIL_REQUEST_LIMIT=5
PASSWORD_RECOVERY_IP_VERIFY_LIMIT=20
PASSWORD_RECOVERY_RATE_WINDOW_SECONDS=900
PASSWORD_RECOVERY_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RECOVERY_DELIVERY_POLL_INTERVAL_SECONDS=5
PASSWORD_RECOVERY_DELIVERY_LEASE_SECONDS=60
PASSWORD_RECOVERY_DELIVERY_MAX_ATTEMPTS=5
PASSWORD_RECOVERY_DELIVERY_RETRY_BASE_SECONDS=30
PASSWORD_RECOVERY_DELIVERY_BATCH_SIZE=20
PASSWORD_RECOVERY_DELIVERY_MAX_RETRY_DELAY_SECONDS=3600
PASSWORD_RECOVERY_CHALLENGE_STATE_RETRY_LIMIT=20
PASSWORD_RECOVERY_RATE_LIMIT_SERIALIZATION_RETRY_LIMIT=3

# ==========================================
# Social Media OAuth Credentials (Meta / Zalo / TikTok)
# ==========================================
# Meta / Facebook for Developers
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=cusc_recruitment_crm_webhook_verify_secret

# Zalo for Developers
ZALO_APP_ID=
ZALO_APP_SECRET=

# TikTok for Business
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
