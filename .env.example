# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=development
PORT=3000

# ==========================================
# PostgreSQL Database Configuration
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=recruitment_crm
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# ==========================================
# Database Connection URL
# - Khi chạy trong Docker: dùng host 'postgres'
# - Khi chạy API trên máy host (ngoài Docker): dùng host 'localhost'
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/recruitment_crm?schema=public

JWT_ACCESS_SECRET=daylasecretkeysieucapbimat32kytu
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
